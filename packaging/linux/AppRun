#!/bin/sh
set -eu

if [ -z "${APPDIR:-}" ]; then
    echo "Wild9Recomp: APPDIR is not set; launch this through the AppImage runtime." >&2
    exit 1
fi

if [ -n "${WILD9RECOMP_DATA_DIR:-}" ]; then
    data_dir=$WILD9RECOMP_DATA_DIR
else
    if [ -n "${XDG_DATA_HOME:-}" ]; then
        data_home=$XDG_DATA_HOME
    elif [ -n "${HOME:-}" ]; then
        data_home=$HOME/.local/share
    else
        echo "Wild9Recomp: HOME is not set; set WILD9RECOMP_DATA_DIR explicitly." >&2
        exit 1
    fi
    data_dir=$data_home/Wild9Recomp
fi

payload=$APPDIR/usr/share/wild9recomp
runtime=$APPDIR/usr/bin/Wild9_Recompiled

if [ ! -x "$runtime" ] || [ ! -f "$payload/game.toml" ] \
   || [ ! -d "$payload/assets" ] || [ ! -d "$payload/bios" ]; then
    echo "Wild9Recomp: AppImage payload is incomplete." >&2
    exit 1
fi

mkdir -p "$data_dir" "$data_dir/saves" "$data_dir/mods"

for tree in assets bios licenses; do
    if [ -d "$payload/$tree" ]; then
        mkdir -p "$data_dir/$tree"
        cp -a "$payload/$tree/." "$data_dir/$tree/"
        chmod -R u+rwX "$data_dir/$tree"
    fi
done

if [ -d "$payload/mods" ]; then
    mkdir -p "$data_dir/mods"
    cp -a "$payload/mods/." "$data_dir/mods/"
    chmod -R u+rwX "$data_dir/mods"
fi

for file in game.toml game_options.toml LICENSE README.md START_HERE.txt; do
    if [ -f "$payload/$file" ]; then
        cp -f "$payload/$file" "$data_dir/$file"
        chmod u+rw "$data_dir/$file"
    fi
done

if [ ! -f "$data_dir/input.ini" ] && [ -f "$payload/input.ini" ]; then
    cp "$payload/input.ini" "$data_dir/input.ini"
    chmod u+rw "$data_dir/input.ini"
fi

launcher=$data_dir/.Wild9Recomp-runtime
ln -sfn "$runtime" "$launcher"
export RECOMP_APPIMAGE_PATH="${APPIMAGE:-}"
unset APPIMAGE

export PATH="$APPDIR/usr/bin${PATH:+:$PATH}"
export XDG_DATA_DIRS="$APPDIR/usr/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"

cd "$data_dir"
exec "$launcher" --game "$data_dir/game.toml" "$@"
